{
  "name": "neeto-record-api",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "https://github.com/neetozone/neeto-record-api.git",
  "license": "MIT",
  "devDependencies": {
    "@redocly/cli": "^2.11.1",
    "husky": "^9.1.7",
    "mint": "4.2.577",
    "nodemon": "^3.1.10"
  },
  "scripts": {
    "build:dev": "nodemon --exec 'scripts/bundle.sh'",
    "docs:preview": "mint dev",
    "docs:publish": "bash scripts/publish_docs.sh",
    "docs:publish:check": "bash scripts/publish_docs.sh --dry-run",
    "check:openapi": "mint openapi-check",
    "check:links": "mint broken-links",
    "postinstall": "husky",
    "cli:catalog": "neetorecord commands > cli/catalog.json",
    "cli:build": "node scripts/generate-cli-reference.mjs",
    "build": "scripts/bundle.sh && yarn cli:build"
  },
  "nodemonConfig": {
    "ext": "yaml",
    "watch": [
      "**"
    ],
    "ignore": [
      "bundled/**",
      "bundled-v1/**"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
