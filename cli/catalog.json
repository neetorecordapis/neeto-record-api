  {
    "command": "neetorecord folders",
    "description": "Manage recording folders",
    "subcommands": [
      {
        "command": "neetorecord folders create",
        "description": "Create a new folder",
        "flags": [
          {
            "name": "name",
            "type": "string",
            "description": "Folder name",
            "required": true
          },
          {
            "name": "parent-folder-id",
            "type": "string",
            "description": "Parent folder ID (for nested folders)"
          }
        ]
      },
      {
        "command": "neetorecord folders list",
        "description": "List all folders",
        "flags": [
          {
            "name": "page",
            "type": "int",
            "default": "0",
            "description": "Page number"
          },
          {
            "name": "page-size",
            "type": "int",
            "default": "0",
            "description": "Items per page (max 100)"
          }
        ]
      }
    ]
  },
  {
    "command": "neetorecord login",
