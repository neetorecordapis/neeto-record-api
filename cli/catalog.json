  },
  {
    "command": "neetorecord logout",
    "description": "Sign out and clear saved credentials",
    "flags": [
      {
        "name": "all",
        "type": "bool",
        "default": "false",
        "description": "Sign out of every saved subdomain"
      }
    ]
  },
  {
    "command": "neetorecord recording-requests",
