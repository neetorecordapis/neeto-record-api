[
  {
    "command": "neetorecord analytics",
    "description": "View organization analytics",
    "subcommands": [
      {
        "command": "neetorecord analytics show",
        "description": "Show organization-wide analytics",
        "flags": [
          {
            "name": "from-date",
            "type": "string",
            "description": "Start date filter (ISO format, e.g. '2024-01-01')"
          },
          {
            "name": "to-date",
            "type": "string",
            "description": "End date filter (ISO format, e.g. '2024-12-31')"
          }
        ]
      }
    ]
  },
